DATABASE_URL=postgresql+psycopg://swing:swing@localhost:5432/swing_trading
JOURNAL_REQUIRED=true
EVENT_PROVIDER=composite
EVENT_UNKNOWN_BLOCKS_TRADE=true
EVENT_DAYS_BEFORE=3
EVENT_DAYS_AFTER=1
AUTO_REFRESH_OUTCOMES=true
OUTCOME_REFRESH_LIMIT=200
OUTCOME_ENTRY_VALID_SESSIONS=3
OUTCOME_MAX_HOLDING_SESSIONS=20
OUTCOME_HISTORY_PERIOD=2y
# Optional; default resolves to backend/data/corporate_events.csv
# MANUAL_EVENTS_CSV=/absolute/path/to/corporate_events.csv
